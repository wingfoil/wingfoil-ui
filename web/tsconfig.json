{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Type-check only: Vite builds the application into web/dist (task-013).
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "rootDir": "src"
  },
  "include": ["src"]
}

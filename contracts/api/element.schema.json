{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wingfoil-ui.local/contracts/api/element.schema.json",
  "title": "GET /api/p/:pid/elements/:eid",
  "description": "One element: its match with the marker, its frontmatter and body (direct read, spec-001 §4.2), descriptor, the required fields of its type and its resolved states (spec-004 §3, spec-001 §4.1).",
  "type": "object",
  "required": ["element", "frontmatter", "body"],
  "properties": {
    "element": {
      "type": "object",
      "required": ["path", "id", "title", "type", "status", "tags", "localChanges"],
      "properties": {
        "path": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "localChanges": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "frontmatter": {
      "$ref": "../files/element.schema.json"
    },
    "body": {
      "type": "string"
    },
    "descriptor": {
      "$ref": "descriptor.schema.json"
    },
    "required": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "missing"],
        "properties": {
          "field": {
            "type": "string"
          },
          "missing": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "states": {
      "description": "The resolved states of the element's type (spec-001 §4.1), for the state machine chips; absent with the descriptor or for an undeclared type.",
      "$ref": "../files/memory-yaml.schema.json#/definitions/states"
    },
    "eventsError": {
      "$ref": "error.schema.json"
    }
  },
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wingfoil-ui.local/contracts/api/directive.schema.json",
  "title": "GET /api/p/:pid/directives/:did",
  "description": "One directive: its list entry, frontmatter and body (direct read, spec-001 §4.3).",
  "type": "object",
  "required": ["entry", "frontmatter", "body"],
  "properties": {
    "entry": {
      "$ref": "../cli/directives-list.schema.json#/properties/entries/items"
    },
    "frontmatter": {
      "$ref": "../files/directive.schema.json"
    },
    "body": {
      "type": "string"
    }
  },
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wingfoil-ui.local/contracts/api/memory-events.schema.json",
  "title": "GET /api/p/:pid/events/memory?before=&limit=",
  "description": "Memory events (spec-002 §1, §3), newest first in git's order: at most limit (1 to 100, default 10) events after the event whose sha is before; more tells whether older events follow (spec-004 §3).",
  "type": "object",
  "required": ["events", "more"],
  "properties": {
    "events": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["sha", "timestamp", "author", "operation", "type", "id", "from", "to", "approver", "reason"],
        "properties": {
          "sha": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "timestamp": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "operation": {
            "enum": ["add", "submit", "approve", "reject", "deprecate"]
          },
          "type": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "from": {
            "type": ["string", "null"]
          },
          "to": {
            "type": ["string", "null"]
          },
          "approver": {
            "type": ["string", "null"]
          },
          "reason": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    },
    "more": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wingfoil-ui.local/contracts/api/error.schema.json",
  "title": "API error",
  "description": "The `error` of the spec-004 §5 envelope `{ error: { code, message, detail? } }`.",
  "type": "object",
  "required": ["code", "message"],
  "properties": {
    "code": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "detail": {}
  },
  "additionalProperties": false
}

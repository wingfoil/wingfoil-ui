{
  "name": "wingfoil-ui",
  "version": "0.1.0",
  "description": "Local web UI for WingFoil-governed projects",
  "type": "module",
  "bin": {
    "wingfoil-ui": "bin/wingfoil-ui.cjs"
  },
  "files": [
    "bin/wingfoil-ui.cjs",
    "server/dist/**/*.js",
    "server/src/i18n/en.json",
    "web/dist/",
    "contracts/api/*.schema.json",
    "contracts/cli/*.schema.json",
    "contracts/files/*.schema.json",
    "contracts/state/*.schema.json",
    "contracts/capabilities.json",
    "contracts/capabilities.schema.json",
    "contracts/matrix.json",
    "CHANGELOG.md"
  ],
  "workspaces": [
    "contracts",
    "server",
    "web"
  ],
  "scripts": {
    "wingfoil": "wingfoil",
    "build": "tsc -b && npm run -s build -w web",
    "prepack": "node scripts/clean-build.mjs && npm run build",
    "typecheck": "tsc -b && tsc -p test",
    "lint": "eslint . && node web/scripts/check-catalogue.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:contract": "vitest run test/contracts",
    "test:timing": "vitest run --config vitest.timing.config.ts && playwright test --config playwright.timing.config.ts",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "docs:api": "typedoc --options typedoc.json"
  },
  "author": "Roberto Pompermaier <robypomper@gmail.com>",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@formatjs/intl": "^6.1.2",
    "ajv": "^8.20.0",
    "fastify": "^5.12.5",
    "pino": "^10.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@formatjs/cli": "^6.16.33",
    "@formatjs/icu-messageformat-parser": "^3.5.21",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-formatjs": "^8.1.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "espree": "^11.2.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wingfoil": "0.2.2"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wingfoil/wingfoil-ui/docs/03_backlog/04_backlog/schema.json",
  "title": "WingFoil UI backlog",
  "description": "Operational backlog exported by specification-downcast (backlog-export): one record per MVP user story, one technical task per SARD requirement. Ids are backlog ids, not Memory ids.",
  "type": "object",
  "required": ["version", "generated_from", "items"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "release": { "type": "string", "pattern": "^v\\d+\\.\\d+$", "description": "Present only in a by-release partition." },
    "generated_from": {
      "type": "object",
      "required": ["story_map", "bdd", "sard"],
      "additionalProperties": false,
      "properties": {
        "story_map": { "type": "string" },
        "bdd": { "type": "string" },
        "sard": { "type": "string" }
      }
    },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "release": { "type": "string", "enum": ["v0.1", "v0.2", "v0.3", "v0.4", "v1.0"] },
    "scenario": {
      "type": "object",
      "required": ["id", "title", "file", "release", "kind", "fixture", "steps"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]-\\d{2}\\.\\d+$" },
        "title": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "pattern": "^docs/02_requirements/02_bdd/features/.+\\.feature$" },
        "release": { "$ref": "#/$defs/release" },
        "kind": { "enum": ["nominal", "edge"] },
        "fixture": { "enum": ["kanban", "custom", "unknown", "any"] },
        "steps": { "type": "array", "minItems": 2, "items": { "type": "string", "pattern": "^(Given|When|Then|And|But|\\|) " } }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "kind", "title", "release", "area", "wingfoil_min", "acceptance_criteria", "dependencies"],
      "properties": {
        "id": { "type": "string", "pattern": "^(US-[A-Z]-\\d{2}|TT-[A-Z]+-\\d{2})$" },
        "kind": { "enum": ["user-story", "technical-task"] },
        "title": { "type": "string", "minLength": 1 },
        "release": { "$ref": "#/$defs/release" },
        "area": { "type": "string", "enum": ["S", "T", "G", "M", "R", "A", "C", "Y", "X", "ARC", "PERF", "STATE", "INT", "SEC"] },
        "wingfoil_min": { "type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?$" },
        "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^TT-[A-Z]+-\\d{2}$" } },
        "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenario" } }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "user-story" },
            "story": { "type": "string", "pattern": "^As .+ I want .+ so that .+" },
            "persona": { "type": "string" },
            "story_kind": { "enum": ["nominal", "edge"] },
            "features": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]\\d+$" } },
            "journeys": { "type": "string" }
          },
          "required": ["story", "persona", "story_kind", "features", "journeys"]
        },
        {
          "properties": {
            "kind": { "const": "technical-task" },
            "requirement": { "type": "string", "pattern": "^REQ-[A-Z]+-\\d{2}$" },
            "description": { "type": "string" },
            "fit_criterion": { "type": "string", "pattern": "^\\[(boolean|numeric|percentage)\\] " },
            "verified_by": { "type": "string" },
            "stories": { "type": "array", "items": { "type": "string", "pattern": "^US-[A-Z]-\\d{2}$" } }
          },
          "required": ["requirement", "description", "fit_criterion", "verified_by", "stories"]
        }
      ]
    }
  }
}
